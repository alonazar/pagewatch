<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for pagewatch, kept here for reference.
  The copy SignPath actually uses is stored in the SignPath project.

  The release workflow uploads one GitHub artifact (a zip) that contains only
  pagewatch-windows.exe. This signs that file with Authenticode.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="pagewatch-windows.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
